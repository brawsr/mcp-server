{
  "name": "@brawsr/mcp-server",
  "version": "0.2.0",
  "description": "Authenticated MCP tools for brawsr browser sessions, checkpoints, rewind, and fork.",
  "packageManager": "npm@11.5.1",
  "mcpName": "io.github.brawsr/brawsr",
  "type": "module",
  "sideEffects": false,
  "bin": {
    "brawsr-mcp-server": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "server.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "npm run format:check && npm run lint && npm run verify:registry && npm run typecheck && npm test",
    "verify:package": "npm run build && node scripts/verify-package.mjs",
    "verify:registry": "node scripts/verify-registry.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "verify": "npm run check && npm run verify:package",
    "prepack": "npm run build"
  },
  "license": "Apache-2.0",
  "author": "brawsr",
  "keywords": [
    "brawsr",
    "mcp",
    "model-context-protocol",
    "browser",
    "checkpoint",
    "rewind",
    "fork"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brawsr/mcp-server.git"
  },
  "homepage": "https://docs.brawsr.io",
  "bugs": {
    "url": "https://github.com/brawsr/mcp-server/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@brawsr/sdk": "0.2.0",
    "@modelcontextprotocol/sdk": "1.32.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.1.2",
    "eslint": "10.8.0",
    "prettier": "3.9.6",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0"
  }
}
